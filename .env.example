# Copy this file to .env and adjust if you need to:
#   cp .env.example .env
#
# .env is git-ignored and holds the real values. This file is committed so
# anyone cloning the repo knows which variables to set, without ever seeing
# a real password.

# --- Database credentials (used by docker compose to create the db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=tasks

# --- How the API reaches the database ---
# Used when you run the API directly on your machine (npm start) against a
# Postgres container that publishes port 5432.
# Inside docker compose this value is overridden automatically, because there
# the database is reachable by its service name (db) instead of localhost.
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks
